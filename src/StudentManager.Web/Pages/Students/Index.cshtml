@page
@model StudentManager.Web.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Studenti";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Studenti</h1>
    <a asp-page="./Create" class="btn btn-success">+ Nový student</a>
</div>

@* Zpráva po uložení (z TempData – zobrazí se jen jednou). *@
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
    </div>
}
@* Chybová zpráva (např. studenta nešlo schválit). *@
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
    </div>
}

@* PROČ method="get": filtry se zapíšou do adresy stránky – odkaz jde uložit nebo poslat a funguje tlačítko Zpět. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label asp-for="Search" class="form-label">Hledat</label>
        <input asp-for="Search" class="form-control" placeholder="Jméno, příjmení, username, třída" />
    </div>
    <div class="col-md-2">
        <label asp-for="SchoolYearId" class="form-label">Školní rok</label>
        <select asp-for="SchoolYearId" asp-items="Model.SchoolYears" class="form-select">
            <option value="">— vše —</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="SchoolClassId" class="form-label">Třída</label>
        <select asp-for="SchoolClassId" asp-items="Model.SchoolClasses" class="form-select">
            <option value="">— vše —</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Status" class="form-label">Stav</label>
        <select asp-for="Status" asp-items="Model.Statuses" class="form-select">
            <option value="">— vše —</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Filtrovat</button>
        @* Zrušit = odkaz na stránku bez parametrů → všechny filtry pryč. *@
        <a asp-page="./Index" class="btn btn-outline-secondary">Zrušit</a>
    </div>
</form>

<p>Zobrazeno: <strong>@Model.Students.Count</strong></p>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-info">Žádní studenti neodpovídají filtru.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Příjmení</th>
                <th>Jméno</th>
                <th>Třída</th>
                <th>Username</th>
                <th>Stav</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr class="@(student.Status == StudentStatus.NeedsReview ? "table-warning" : "")">
                    <td>@student.LastName</td>
                    <td>@student.FirstName</td>
                    <td>@student.SchoolClass?.Name</td>
                    <td>@student.Username</td>
                    <td>
                        <span class="badge @student.Status.ToBadgeClass()">@student.Status.ToCzech()</span>
                        @* Důvod kontroly (vyplňuje aplikace), pod ním poznámka admina. *@
                        @if (!string.IsNullOrEmpty(student.ReviewReason))
                        {
                            <div class="small">@student.ReviewReason</div>
                        }
                        @if (!string.IsNullOrEmpty(student.AdminNote))
                        {
                            <div class="small text-muted">@student.AdminNote</div>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        @* asp-route-id doplní id do adresy: /Students/Edit/5 *@
                        <a asp-page="./Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Upravit</a>
                        @if (student.Status is StudentStatus.Draft or StudentStatus.NeedsReview)
                        {
                            @* PROČ tag helper (asp-page-handler, asp-route-id): sestaví adresu
                               /Students?handler=Approve&id=5 a sám přidá skryté pole s antiforgery
                               tokenem – ochranu proti odeslání formuláře z cizího webu.
                               Skrytá pole s filtry: po schválení se vrátíme na stejně vyfiltrovaný seznam.
                               PROČ name/value a ne asp-for: asp-for by v každém řádku vytvořil
                               stejné id="Search" a id na stránce má být jedinečné. *@
                            <form method="post" asp-page-handler="Approve" asp-route-id="@student.Id" class="d-inline">
                                <input type="hidden" name="Search" value="@Model.Search" />
                                <input type="hidden" name="SchoolYearId" value="@Model.SchoolYearId" />
                                <input type="hidden" name="SchoolClassId" value="@Model.SchoolClassId" />
                                <input type="hidden" name="Status" value="@Model.Status" />
                                <button type="submit" class="btn btn-sm btn-success">Schválit</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
