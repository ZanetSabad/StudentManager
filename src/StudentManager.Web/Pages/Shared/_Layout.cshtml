@{
    // Která stránka je právě otevřená – podle toho zvýrazníme položku v menu.
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Student Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex flex-column flex-md-row min-vh-100">

        <nav class="sidebar bg-dark p-3">
            <a class="sidebar-brand" asp-page="/Index">Student Manager</a>

            <ul class="nav nav-pills flex-column gap-1 mt-3">
                <li class="nav-item">
                    <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">Přehled</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPage.StartsWith("/Students") ? "active" : "")" asp-page="/Students/Index">Studenti</a>
                </li>

                @* DALŠÍ KROKY: tyto stránky zatím neexistují – až vzniknou, změníme <span> na <a asp-page="..."> *@
                <li class="nav-item"><span class="nav-link disabled">Třídy</span></li>
                <li class="nav-item"><span class="nav-link disabled">Import CSV</span></li>
                <li class="nav-item"><span class="nav-link disabled">Export</span></li>
                <li class="nav-item"><span class="nav-link disabled">Nastavení</span></li>
            </ul>
        </nav>

        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>